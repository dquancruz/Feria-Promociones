# Copy this file to .env (root, gitignored) and fill in real values for local development.

# --- Backend ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://feria:feria@localhost:5434/feria
SESSION_SECRET=change-me-in-every-environment
# Optional: only for a browser app on another origin that calls the API directly.
# The bundled frontend proxies /api, so it is not needed.
# CORS_ORIGIN=
# Optional: enables GET /api/admin/registrations (and .csv). Leave unset to
# keep the admin router from mounting at all.
ADMIN_API_KEY=

# --- Frontend ---
# Where the frontend server forwards /api and /health (runtime). Only the
# containerized frontend reads this; `npm run dev:frontend` proxies to
# http://localhost:4000 on its own.
API_PROXY_TARGET=http://localhost:4000

# --- Postgres (used by docker-compose for local dev) ---
POSTGRES_USER=feria
POSTGRES_PASSWORD=feria
POSTGRES_DB=feria
